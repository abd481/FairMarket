{
  "base_url": "https://www.dubizzle.com.eg",

  "listing": {
    "cards": "li[aria-label='Listing']",
    "link_selector": "a",
    "pagination_url": "/en/properties/apartments-duplex-for-sale/q-Cairo/?page={page}"
  },

  "detail": {
    "fields": {
      "Price": "span[aria-label='Price']",
      "Location": "span[aria-label='Location']",
      "Beds": "span:has-text('Bedrooms') + span",
      "Baths": "span:has-text('Bathrooms') + span",
      "Area": "span:has-text('Area') + span",
      "Type": "span:has-text('Type') + span",
      "Furnishing": "span:has-text('Furnished') + span",
      "Reactivated_Date": "[aria-label='Creation date']"
    },

    "amenities": {
      "section_title": "h3:has-text('Amenities')",
      "button_label": null,
      "dialog": null,
      "fallback_items": "span._384b23be"
    }
  }
}